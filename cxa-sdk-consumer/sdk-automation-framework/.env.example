# ─── Environment ─────────────────────────────────────────────
# Options: local | dev | staging | production
TEST_ENV=dev

# ─── Base URLs ───────────────────────────────────────────────
BASE_URL=http://localhost:3000
API_BASE_URL=https://api.example.com/v1

# ─── CXone Configuration ────────────────────────────────────
CXONE_HOSTNAME=https://cxone.staging.niceincontact.com
CXONE_CLIENT_ID=Salesforce Agent Console@inContact Inc.
CXONE_REDIRECT_URI=http://localhost:3000/auth-callback

# ─── OAuth / API Credentials ────────────────────────────────
CLIENT_ID=test-client
CLIENT_SECRET=test-secret

# ─── Test User Credentials ──────────────────────────────────
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=password123

# ─── Logging ─────────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info

# ─── CI flag (set by CI pipeline) ───────────────────────────
# CI=true
